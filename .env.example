# Backend Configuration
PORT=8080
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/omnikey?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
AES_SECRET=your_aes_encryption_secret_key_here
CLIENT_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Dispatcher Options:
# Option 1: Brevo (Sendinblue) API (https://brevo.com - 300 free emails/day to ANY email address)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_brevo_registered_email@gmail.com
BREVO_SENDER_NAME=Omnikey Security

# Option 2: Resend API Key (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Omnikey <onboarding@resend.dev>

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
