# Backend Configuration
PORT=8080
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/omnikey?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
AES_SECRET=your_aes_encryption_secret_key_here
CLIENT_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Dispatcher Options:
# Option 1: Resend API Key (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Omnikey <onboarding@resend.dev>

# Option 2: Gmail SMTP (Requires 2-Step Verification ON -> Google App Password)
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_PASS=your_16_char_gmail_app_password

# Option 3: Brevo (Sendinblue) Free SMTP
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_account_email@gmail.com
# SMTP_PASS=your_brevo_smtp_key

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
